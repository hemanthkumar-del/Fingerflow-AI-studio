# Environment Configuration for FingerFlow Studio

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API Endpoint (Render Deployed URL in Production)
VITE_API_BASE_URL=https://your-fingerflow-backend.onrender.com

# Firebase SDK Client Keys (Vercel Environment Variables)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
